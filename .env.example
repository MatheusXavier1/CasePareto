# Segredo do Make (validador) e das rotas do ERP simulado. Use uma string longa e aleatória.
TOKEN=troque-por-um-segredo-longo
# Segredo da Mesa (só rotas casos e acao). Abra a Mesa uma vez com /?token=<TOKEN_MESA>
TOKEN_MESA=troque-por-outro-segredo

# Preenchidas sozinhas ao conectar o Upstash Redis pelo Marketplace da Vercel (Storage)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Opcionais
# MAKE_WEBHOOK_URL=   webhook do Make que envia a resposta final ao fornecedor
# ERP_SIM=normal      normal (20% de 503) | estavel (sem falhas) | falha (sempre 503)
# HOJE_FIXO=2026-10-01   congela "hoje" para a demonstração
